public class TestMyPoint {
    public static void main(String[] args) {
        // --- PHẦN 1: Kiểm tra lớp MyPoint và các phương thức ---
        
        // Test constructor và toString()
        MyPoint p1 = new MyPoint(); 
        System.out.println(p1); // Kết quả: (0,0)

        // Test setters
        p1.setX(8); 
        p1.setY(6);
        
        // Test getters
        System.out.println("x is: " + p1.getX()); // Kết quả: x is: 8
        System.out.println("y is: " + p1.getY()); // Kết quả: y is: 6

        // Test setXY()
        p1.setXY(3, 0); 
        System.out.println(p1.getXY()[0]); // Kết quả: 3
        System.out.println(p1.getXY()[1]); // Kết quả: 0
        System.out.println(p1); // Kết quả: (3,0)

        // Test constructor có tham số khác
        MyPoint p2 = new MyPoint(0, 4); 
        System.out.println(p2); // Kết quả: (0,4)

        // Test các phương thức distance() quá tải (overloaded)
        System.out.println(p1.distance(p2));    // Gọi distance(MyPoint)
        System.out.println(p1.distance(p1));    // Gọi distance(MyPoint)
        System.out.println(p1.distance(5, 6));  // Gọi distance(int, int)
        System.out.println(p1.distance());      // Gọi distance() tới (0,0)

        System.out.println("--------------------------------------------------");

        // --- PHẦN 2: Tạo mảng chứa 10 điểm MyPoint từ (1,1) đến (10,10) ---
        MyPoint[] points = new MyPoint[10]; // Khai báo và cấp phát mảng 10 phần tử
        
        for (int i = 0; i < points.length; i++) {
            points[i] = new MyPoint(i + 1, i + 1); // Khởi tạo từng đối tượng MyPoint với giá trị (1,1) đến (10,10)
        }

        // Sử dụng vòng lặp để in ra tất cả các điểm trong mảng
        for (int i = 0; i < points.length; i++) {
            System.out.println("Point " + (i + 1) + ": " + points[i].toString());
        }
    }
}
