public class MyPoint {
    // Các biến thành viên (instance variables)
    private int x;
    private int y;

    // Constructor mặc định (không tham số), khởi tạo điểm tại (0, 0)
    public MyPoint() {
        this.x = 0;
        this.y = 0;
    }

    // Constructor có tham số để khởi tạo x và y
    public MyPoint(int x, int y) {
        this.x = x;
        this.y = y;
    }

    // Getter cho x
    public int getX() {
        return x;
    }

    // Setter cho x
    public void setX(int x) {
        this.x = x;
    }

    // Getter cho y
    public int getY() {
        return y;
    }

    // Setter cho y
    public void setY(int y) {
        this.y = y;
    }

    // Phương thức setXY để gán đồng thời x và y
    public void setXY(int x, int y) {
        this.x = x;
        this.y = y;
    }

    // Phương thức getXY trả về một mảng int chứa {x, y}
    public int[] getXY() {
        int[] results = new int[2];
        results[0] = this.x;
        results[1] = this.y;
        return results;
    }

    // Phương thức toString trả về chuỗi theo định dạng "(x,y)"
    public String toString() {
        return "(" + this.x + "," + this.y + ")";
    }

    // Tính khoảng cách từ điểm hiện tại đến tọa độ (x, y) cho trước
    public double distance(int x, int y) {
        int xDiff = this.x - x;
        int yDiff = this.y - y;
        return Math.sqrt(xDiff * xDiff + yDiff * yDiff);
    }

    // Tính khoảng cách từ điểm hiện tại đến một đối tượng MyPoint khác
    public double distance(MyPoint another) {
        int xDiff = this.x - another.x;
        int yDiff = this.y - another.y;
        return Math.sqrt(xDiff * xDiff + yDiff * yDiff);
    }

    // Tính khoảng cách từ điểm hiện tại đến gốc tọa độ (0, 0)
    public double distance() {
        int xDiff = this.x - 0;
        int yDiff = this.y - 0;
        return Math.sqrt(xDiff * xDiff + yDiff * yDiff);
    }
}
